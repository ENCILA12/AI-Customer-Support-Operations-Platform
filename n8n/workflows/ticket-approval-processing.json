{
  "name": "WF-04: Human Approval Processing (Handoff)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "approval-decision",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "id": "webhook-approval",
      "name": "Webhook: Manager Approval Event"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8000/api/v1/approvals/process",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [280, 0],
      "id": "http-process-approval",
      "name": "FastAPI: Process Approval & Audit"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.decision }}",
              "operation": "equal",
              "value2": "approved"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [560, 0],
      "id": "if-approved",
      "name": "If Approved"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"dispatched\",\n  \"approval\": {{ JSON.stringify($json) }},\n  \"action\": \"Email/Notification sent to customer.\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [840, -100],
      "id": "respond-approved",
      "name": "Respond: Sent to Customer"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"held\",\n  \"approval\": {{ JSON.stringify($json) }},\n  \"action\": \"Ticket held or escalated for tier 2 support.\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [840, 100],
      "id": "respond-held",
      "name": "Respond: Ticket Escalated/Rejected"
    }
  ],
  "connections": {
    "Webhook: Manager Approval Event": {
      "main": [
        [
          {
            "node": "FastAPI: Process Approval & Audit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "FastAPI: Process Approval & Audit": {
      "main": [
        [
          {
            "node": "If Approved",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If Approved": {
      "main": [
        [
          {
            "node": "Respond: Sent to Customer",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond: Ticket Escalated/Rejected",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
