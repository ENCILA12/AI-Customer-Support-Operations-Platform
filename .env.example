# Environment Configuration

# 1. Database & Supabase (PostgreSQL with pgvector)
# Get your connection string from Supabase -> Project Settings -> Database
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_URL=https://[your-project-id].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# 2. FastAPI Backend
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5678

# 3. LLM API (Groq Cloud / Gemini)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 4. n8n Automation Engine
N8N_PORT=5678
N8N_BASIC_AUTH_ACTIVE=false
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=change_this_encryption_key_in_production

# 5. Operations Desk Dashboard
VITE_API_URL=http://127.0.0.1:8000

